    "@nuxt/content": "^3.16.2",
    "@nuxtjs/sitemap": "^9.1.0",
    "@vueuse/core": "^15.0.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "fuse.js": "^7.5.0",
    "nuxt": "^4.6.4",
    "reka-ui": "^2.11.0",
    "shadcn-nuxt": "2.9.0",
